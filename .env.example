# Copie este arquivo para ".env" e preencha quando a API Java existir.
#
# Enquanto VITE_API_URL estiver vazia ou ausente, o site roda inteiro com os
# dados de exemplo de src/data/ e nao tenta acessar a rede.
#
# Sprint 4, rodando local:
# VITE_API_URL=http://localhost:8080/api
#
# O arquivo ".env" NAO vai para o GitHub (esta no .gitignore).
VITE_API_URL=
